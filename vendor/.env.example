# ---------------------------------------------------------------------------
# vendor/.env.example  -  environment for the LOCAL (claude-shim) TradingAgents run
# ---------------------------------------------------------------------------
# The keyless profile in run-local.py (analysts: market + fundamentals) needs
# NO API keys at all. yfinance supplies stock prices, technical indicators,
# fundamentals and financial statements without any key.
#
# You only need entries below if you deviate from that profile.
# TradingAgents auto-loads a .env from its own package dir; you can also just
# `set VAR=...` in the shell before launching, or edit run-local.py.
# ---------------------------------------------------------------------------

# The "openai" provider requires SOME OpenAI key to be present. run-local.py sets
# a dummy automatically; the shim never checks it. Uncomment only to override.
#OPENAI_API_KEY=sk-local-dummy

# Point TradingAgents at the shim. run-local.py already hardcodes this; set it
# only if you changed the shim port (SHIM_PORT).
#TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:8787/v1

# --- Optional data keys (NOT needed for the keyless market+fundamentals run) ---
#
# FRED — Federal Reserve macro data (CPI, PCE, unemployment, fed funds, yields).
# Only required if you add the "news" analyst (it calls get_macro_indicators).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Alpha Vantage — alternative vendor for stock/indicator/fundamental/news data.
# Only needed if you switch data_vendors away from the yfinance default.
#ALPHA_VANTAGE_API_KEY=
