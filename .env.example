# cp .env.example .env  →  chmod 600 .env  →  값 채우기.  .env 는 git 에 올라가지 않는다.
# systemd 유닛(ops/trading-floor.service)이 이 파일을 EnvironmentFile 로 읽는다.

# --- 바이낸스 USDⓈ-M 선물 -------------------------------------------------------
# 반드시 데모(가짜 돈) 주소로 시작한다. 실계좌 주소(https://fapi.binance.com)는
# docs/00-CEO-PLAN.md 의 Phase 2b 진입 조건을 전부 충족한 뒤에만 바꾼다.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com

# --- 텔레그램 -------------------------------------------------------------------
# @BotFather 토큰. chatId 는 config.json 의 telegram.chatId 에 둔다.
TELEGRAM_BOT_TOKEN=

# --- 대시보드 로그인 (8000 포트 웹 화면) -----------------------------------------
# 비밀번호가 비어 있으면 로그인 자체가 막힌다(fail-closed).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- 선택 ------------------------------------------------------------------------
# FRED 거시 캘린더(CPI·FOMC 등). 무료 키: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 자동분석 모델. 예약·감시 자동분석은 sonnet 으로 구독 한도를 아낀다. 수동 심층 분석만 opus.
FLOOR_MODEL=sonnet
