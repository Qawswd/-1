// PIXEL TRADING FLOOR — 감시 트리거 + 가설(H1·H2·M0) 인디케이터  (Pine Script v6)
// 15분봉 차트(BINANCE:BTCUSDT.P / ETHUSDT.P)용. 서버 감시기(watcher.js·indicators.js·hypotheses.js)와 같은 규칙.
//   트리거 : 직전 15분봉 대비 |변동| >= movePct
//   추세   : (가격 > 일봉 SMA20) 또는 (일봉 MACD 히스토그램 > 0) 이 움직인 방향과 일치
//   역추세 : 20일 구간(고가~저가) 안 가격 위치가 하단 band% (하락 시) / 상단 band% (상승 시)
//   H1     : BTC · 하락 >= 2% · 역추세 -> 롱, 손절 1.5xATR(14), 목표 2.5R
//   H2     : ETH · |변동| >= 2% · 추세 -> 같은 방향, 손절 2xATR, 목표 1.8R
//   M0     : |변동| >= 1.5% · 추세 또는 역추세 -> 같은 방향, 손절 1.5xATR, 목표 1.8R
// 표시: 트리거 봉 삼각형(필터 통과는 진하게), 가설 라벨, 신호 봉의 손절(빨강 x)·목표(초록 x) 점.
// 이 파일은 일부러 들여쓰기 블록을 쓰지 않는다 — 폰 편집기가 붙여넣기 때 들여쓰기를 덧붙여 깨지기 때문.
// 설치: TradingView -> Pine 편집기 -> 전체 붙여넣기 -> 저장 -> 차트에 추가.

//@version=6
indicator("PIXEL FLOOR 트리거·가설", overlay=true)

movePct = input.float(1.5, "트리거 변동(%)", minval=0.1, step=0.1)
bandPct = input.float(20.0, "역추세 구간(%)", minval=5, maxval=45, step=1)
bigMovePct = input.float(2.0, "H1/H2 최소 변동(%)", minval=0.5, step=0.1)
atrLen = input.int(14, "ATR 기간(현재 봉)", minval=2)
showM0 = input.bool(true, "M0 기본 규칙 표시")
showLevels = input.bool(true, "손절/목표 점 표시")

chg = (close - close[1]) / close[1] * 100
trigUp = chg >= movePct
trigDown = chg <= -movePct
trig = trigUp or trigDown

dSma20 = request.security(syminfo.tickerid, "D", ta.sma(close, 20))
[dMacd, dSig, dHist] = request.security(syminfo.tickerid, "D", ta.macd(close, 12, 26, 9))
dHigh20 = request.security(syminfo.tickerid, "D", ta.highest(high, 20))
dLow20 = request.security(syminfo.tickerid, "D", ta.lowest(low, 20))

aboveMa = close > nz(dSma20, close)
histUp = nz(dHist, 0) > 0
trendOk = trigUp ? (aboveMa or histUp) : ((not aboveMa) or (not histUp))
rangePos = nz((close - dLow20) / (dHigh20 - dLow20) * 100, 50)
revOk = trigUp ? rangePos >= 100 - bandPct : rangePos <= bandPct
filterOk = trig and (trendOk or revOk)

atrNow = ta.atr(atrLen)
isBTC = str.contains(syminfo.ticker, "BTC")
isETH = str.contains(syminfo.ticker, "ETH")
bigMove = math.abs(chg) >= bigMovePct

h1 = trig and isBTC and trigDown and bigMove and revOk
h2Long = trig and isETH and trigUp and bigMove and trendOk
h2Short = trig and isETH and trigDown and bigMove and trendOk
m0Base = showM0 and filterOk and not h1 and not h2Long and not h2Short
m0Long = m0Base and trigUp
m0Short = m0Base and trigDown

h1Stop = h1 ? close - 1.5 * atrNow : na
h1Tgt = h1 ? close + 1.5 * atrNow * 2.5 : na
h2Stop = h2Long ? close - 2.0 * atrNow : h2Short ? close + 2.0 * atrNow : na
h2Tgt = h2Long ? close + 2.0 * atrNow * 1.8 : h2Short ? close - 2.0 * atrNow * 1.8 : na
m0Stop = m0Long ? close - 1.5 * atrNow : m0Short ? close + 1.5 * atrNow : na
m0Tgt = m0Long ? close + 1.5 * atrNow * 1.8 : m0Short ? close - 1.5 * atrNow * 1.8 : na

plotshape(trigUp and not filterOk, title="상승 트리거(필터 탈락)", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 70), size=size.tiny)
plotshape(trigDown and not filterOk, title="하락 트리거(필터 탈락)", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 70), size=size.tiny)
plotshape(trigUp and filterOk, title="상승 트리거(필터 통과)", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(trigDown and filterOk, title="하락 트리거(필터 통과)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

plotshape(h1, title="H1 롱", style=shape.labelup, location=location.belowbar, color=color.blue, textcolor=color.white, text="H1 롱", size=size.small)
plotshape(h2Long, title="H2 롱", style=shape.labelup, location=location.belowbar, color=color.purple, textcolor=color.white, text="H2 롱", size=size.small)
plotshape(h2Short, title="H2 숏", style=shape.labeldown, location=location.abovebar, color=color.purple, textcolor=color.white, text="H2 숏", size=size.small)
plotshape(m0Long, title="M0 롱", style=shape.labelup, location=location.belowbar, color=color.gray, textcolor=color.white, text="M0", size=size.tiny)
plotshape(m0Short, title="M0 숏", style=shape.labeldown, location=location.abovebar, color=color.gray, textcolor=color.white, text="M0", size=size.tiny)

plot(showLevels ? h1Stop : na, title="H1 손절", color=color.red, style=plot.style_cross, linewidth=3)
plot(showLevels ? h1Tgt : na, title="H1 목표", color=color.green, style=plot.style_cross, linewidth=3)
plot(showLevels ? h2Stop : na, title="H2 손절", color=color.red, style=plot.style_cross, linewidth=3)
plot(showLevels ? h2Tgt : na, title="H2 목표", color=color.green, style=plot.style_cross, linewidth=3)
plot(showLevels ? m0Stop : na, title="M0 손절", color=color.new(color.red, 40), style=plot.style_circles, linewidth=2)
plot(showLevels ? m0Tgt : na, title="M0 목표", color=color.new(color.green, 40), style=plot.style_circles, linewidth=2)

plot(dSma20, title="일봉 SMA20", color=color.new(color.orange, 30), linewidth=1)
plot(dHigh20, title="20일 고점", color=color.new(color.gray, 60), style=plot.style_linebr)
plot(dLow20, title="20일 저점", color=color.new(color.gray, 60), style=plot.style_linebr)

alertcondition(filterOk, title="필터 통과 트리거", message="PIXEL FLOOR 트리거 통과: {{ticker}} {{close}}")
alertcondition(h1, title="H1 BTC 급락 저점권 롱", message="H1 {{ticker}} 롱 후보 @ {{close}}")
alertcondition(h2Long or h2Short, title="H2 ETH 급변동 추세", message="H2 {{ticker}} 추세 후보 @ {{close}}")
