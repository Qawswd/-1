    "intervalSec": 60,
    "triggers": { "movePct": 1.5, "windowMin": 15, "volumeMultiple": 2.5, "minVolumeNotional": 3000, "fundingAbs": 0.05, "premiumPct": 1.0 },
    "autoAnalyze": true,
    "autoMode": "algo",
    "marketHoursOnly": false,
    "cooldownMin": 60,
    "positionReviewCooldownHours": 3,
    "trailAtrMultiple": 2.5,
    "structureFilterEnabled": true,
    "reversalFilterEnabled": true,
    "reversalBandPct": 20,
    "analysisTriggerKinds": ["move"],
    "alertKinds": ["move", "funding", "premium"],
    "analysisBudget": { "enabled": true, "total": 8, "planning": 0, "level": 0, "move": 8 },
    "quietHours": []
  },

